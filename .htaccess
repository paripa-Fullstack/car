# Включение RewriteEngine
RewriteEngine On

# Установка базовой директории
RewriteBase /

# 1. Скрываем расширение .php
# Если запрос соответствует файлу .php, отдаем его без расширения в URL
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.*)$ $1.php [L]

# 2. Маршрутизация для car.php (пример: /car/bmw-x5 -> car.php?slug=bmw-x5)
# Это позволит делать красивые ссылки на машины в будущем
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^car/([a-zA-Z0-9-]+)/?$ car.php?slug=$1 [L,QSA]

# 3. Маршрутизация для catalog (фильтры)
# Пример: /catalog/bmw/3-series -> catalog.php?brand=bmw&model=3-series
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^catalog/([a-zA-Z0-9-]+)/([a-zA-Z0-9-]+)/?$ catalog.php?brand=$1&model=$2 [L,QSA]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^catalog/([a-zA-Z0-9-]+)/?$ catalog.php?brand=$1 [L,QSA]

# 4. Защита файлов
# Запрет доступа к системным файлам
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

# Запрет просмотра содержимого папок
Options -Indexes

# Кэширование статики (CSS, JS, Images) для ускорения загрузки
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
    ExpiresByType application/x-javascript "access plus 1 week"
</IfModule>

# Сжатие GZIP (если включено на сервере)
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json
</IfModule>

# Кодировка по умолчанию
AddDefaultCharset UTF-8

# Страницы ошибок (опционально, можно создать 404.php)
ErrorDocument 404 /404.php